{
  "database": {
    "rules": "db/firebase_rules.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "flutter-app-982b4",
          "appId": "1:536514315583:android:614f70874f27d738923f8a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "flutter-app-982b4",
          "configurations": {
            "android": "1:536514315583:android:614f70874f27d738923f8a",
            "ios": "1:536514315583:ios:32541e941cccbdcf923f8a",
            "web": "1:536514315583:web:8274f9fbcdc01126923f8a",
            "windows": "1:536514315583:web:d97f032d9d7e7634923f8a"
          }
        }
      }
    }
  }
}
